{
  "buildCommand": "npm install && npm run build",
  "outputDirectory": "vercel_build",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://stafin-homes.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/$1.html"
    }
  ]
}
